# Copy to .env and fill in. Never commit .env.

# Postgres. Two roles: the poller writes with RW, the HTTP API reads with RO.
DATABASE_URL_RW=postgres://momarchive_rw:CHANGE_ME@127.0.0.1:5432/momarchive
DATABASE_URL_RO=postgres://momarchive_ro:CHANGE_ME@127.0.0.1:5432/momarchive

# S3 compatible storage (RustFS on the same VPS)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mom-archive
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# Momentum Mod
MOMENTUM_API=https://api.momentum-mod.org/v1
MOMENTUM_CDN=https://cdn.momentum-mod.org
# Comma separated Gamemode ids to archive. 3 = Bhop HL1.
ARCHIVE_GAMEMODES=3
# Download map BSP files too (large, off by default)
ARCHIVE_BSPS=false
# Optional JWT from a logged in momentum-mod.org session. Enables /maps/submissions for faster beta discovery.
MOMENTUM_TOKEN=

# Poller cadence
POLL_RUNS_MINUTES=10
POLL_MAPS_HOURS=6
POLL_USERS_SWEEP_HOURS=24
POLL_LEADERBOARDS_SWEEP_HOURS=24
POLL_MAPS_WALK_HOURS=24
REPLAY_CONCURRENCY=4
POLLER_ENABLED=true

# Momentum API budget (hard limits are 20/s and 200/min per IP, stay under both)
RATE_LIMIT_RPS=15
RATE_LIMIT_RPM=180
USER_AGENT=mom-archive/1.0 (+https://momarchive.caixa.cc; contact: you@example.com)

# Steam Web API key, https://steamcommunity.com/dev/apikey. Leave empty to disable the Steam side.
STEAM_API_KEY=
# SteamHistory.net API key (SourceBans). Leave empty to disable.
STEAMHISTORY_API_KEY=
STEAMHISTORY_ENABLED=true

# HTTP
PORT=5771
BIND_HOST=127.0.0.1
# Set to true only if you really want the backend reachable outside loopback.
ALLOW_PUBLIC_BIND=false
PUBLIC_BASE_URL=https://momarchive.caixa.cc

# Logging
LOG_LEVEL=info
LOG_DIR=logs
NODE_ENV=production
