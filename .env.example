# Copy to .env and fill in. Never commit .env.

# Postgres. Three roles: the poller writes with RW, the HTTP API reads with RO,
# and APP is the only write path the web facing side has: the five admin tables
# (sessions, announcements, user notices, audit, request log) and nothing else.
DATABASE_URL_RW=postgres://momarchive_rw:CHANGE_ME@127.0.0.1:5432/momarchive
DATABASE_URL_RO=postgres://momarchive_ro:CHANGE_ME@127.0.0.1:5432/momarchive
DATABASE_URL_APP=postgres://momarchive_app:CHANGE_ME@127.0.0.1:5432/momarchive

# S3 compatible storage (RustFS on the same VPS)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mom-archive
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# Momentum Mod
MOMENTUM_API=https://api.momentum-mod.org/v1
MOMENTUM_CDN=https://cdn.momentum-mod.org
# Comma separated Gamemode ids to archive. 3 = Bhop HL1.
ARCHIVE_GAMEMODES=3
# Download map BSP files too (large, off by default)
ARCHIVE_BSPS=false
# Optional JWT from a logged in momentum-mod.org session. Enables /maps/submissions for faster beta discovery.
MOMENTUM_TOKEN=

# Poller cadence
POLL_RUNS_MINUTES=10
POLL_MAPS_HOURS=6
POLL_USERS_SWEEP_HOURS=24
POLL_LEADERBOARDS_SWEEP_HOURS=24
POLL_MAPS_WALK_HOURS=24
REPLAY_CONCURRENCY=4
POLLER_ENABLED=true

# Momentum API budget (hard limits are 20/s and 200/min per IP, stay under both)
RATE_LIMIT_RPS=15
RATE_LIMIT_RPM=180
USER_AGENT=mom-archive/1.0 (+https://momarchive.org; contact: westlargo@proton.me)

# Steam Web API key, https://steamcommunity.com/dev/apikey. Leave empty to disable the Steam side.
STEAM_API_KEY=
# SteamHistory.net API key (SourceBans). Leave empty to disable.
STEAMHISTORY_API_KEY=
STEAMHISTORY_ENABLED=true

# HTTP
PORT=5771
BIND_HOST=127.0.0.1
# Set to true only if you really want the backend reachable outside loopback.
ALLOW_PUBLIC_BIND=false
PUBLIC_BASE_URL=https://momarchive.org

# Admin panel at /admin. Not linked from the site; sign in is Steam OpenID and only
# the SteamID64s listed here are ever given a session. Leave all three empty to run
# the archive with no panel at all (then the endpoints do not even exist).
# openssl rand -hex 32  ->  APP_SECRET. Changing it signs every session out.
APP_SECRET=
ADMIN_STEAM_IDS=
SESSION_TTL_HOURS=720
SESSION_IDLE_HOURS=168

# Request log feeding the panel's traffic view: IP, country, path, status, user agent.
# Rows older than the retention are deleted by the daily housekeeping job.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_DAYS=30

# Logging
LOG_LEVEL=info
LOG_DIR=logs
NODE_ENV=production
